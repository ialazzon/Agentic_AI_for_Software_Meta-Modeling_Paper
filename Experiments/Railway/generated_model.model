  <elements xsi:type="railwaypackage:Segment" length="10" connected="//@elements.4 //@elements.5"/>
  <elements xsi:type="railwaypackage:Turnout" length="10" from="//@elements.1" straight="//@elements.3" divergent="//@elements.2"/>
  <elements xsi:type="railwaypackage:Turnout" length="10" from="//@elements.3" straight="//@elements.6" divergent="//@elements.7"/>
  <elements xsi:type="railwaypackage:Turnout" length="10" from="//@elements.3" straight="//@elements.7" divergent="//@elements.3"/>
  <elements xsi:type="railwaypackage:Segment" length="10" connected="//@elements.5 //@elements.6"/>
