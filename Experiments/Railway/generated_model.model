<railwaypackage:RailwayLayout xmlns:xmi="http://www.omg.org/XMI" xmlns:railwaypackage="prolan.example.railwaypackage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0">
  <elements xsi:type="railwaypackage:Segment" length="15" connected="//@elements.1 //@elements.2"/>
  <elements xsi:type="railwaypackage:Signal" length="10" connected="//@elements.0"/>
